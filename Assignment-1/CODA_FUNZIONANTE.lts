/*
ALLOOOORA, la coda in sé funziona e riesce a gestire i turni degli utenti.
Manca da gestire il limite di utenti per piano
*/

const N = 3
const M = 3
const EMPTY = 0
const FULL = 1
const NUM_USER = 3
range FLOORS_RANGE = 0..N-1
range MODE = 0..1
range RANGE_QUEUE = 0..M-1
range USERS = 1..NUM_USER

LOCK = (acquire -> release -> LOCK).

LIFT = EMPTY[0],
EMPTY[f:FLOORS_RANGE] =
	(floor_button_pressed[user:USERS][floor:FLOORS_RANGE] -> MOVING[f][floor][EMPTY]
	|alarm_triggered -> EMERGENCY[f][EMPTY]),
MOVING[start:FLOORS_RANGE][finish:FLOORS_RANGE][mode:MODE] =
	(when (start == finish) open_door -> ON_FLOOR[start]
	|when (start < finish) move_up -> MOVING[start+1][finish][mode]
	|when (start > finish) move_down -> MOVING[start-1][finish][mode]
	|alarm_triggered -> EMERGENCY[start][mode]),
ON_FLOOR[f:FLOORS_RANGE] = 
	(enter[user:USERS] -> FULL[f]
	|exit[user:USERS] -> close_door -> EMPTY[f]
	|alarm_triggered -> close_door_emergency -> EMERGENCY[f][EMPTY]),
FULL[f:FLOORS_RANGE] = 
	(lift_button_pressed[user:USERS][floor:FLOORS_RANGE] -> close_door -> MOVING[f][floor][FULL]
	|alarm_triggered -> close_door_emergency -> EMERGENCY[f][FULL]),
EMERGENCY[start:FLOORS_RANGE][mode:MODE] = 
	(when (start > 0) move_down -> EMERGENCY[start-1][mode]
	|when (start == 0 && mode == FULL) open_door_emergency -> signal -> close_door -> EMPTY[0]
	|when (start == 0 && mode == EMPTY) open_door -> signal -> close_door -> EMPTY[0]).


USER(U = 0) = 
	(get_in_line[U][position:RANGE_QUEUE] -> IN_LINE[position]),
IN_LINE[position:RANGE_QUEUE] =
	(serve[U][position] -> CALLING),
CALLING = 
	(floor_button_pressed[U][floor:FLOORS_RANGE] -> WAITING
	|alarm_triggered -> USER),
WAITING = 
	(enter[U] -> ON_BOARD
	|alarm_triggered -> USER),
ON_BOARD = 
	(lift_button_pressed[U][dest:FLOORS_RANGE] -> MOVING_USER
	|alarm_triggered -> EXIT_EMERGENCY),
MOVING_USER = 
	(exit[U] -> USER
	|alarm_triggered -> EXIT_EMERGENCY),
EXIT_EMERGENCY = (open_door_emergency -> exit_emergency -> release -> USER).


FLOOR = QUEUE[0][0][0][EMPTY],
QUEUE[head:RANGE_QUEUE][tail:RANGE_QUEUE][tot:0..M][serving:MODE] = 
	(when (tot < M) get_in_line[user:USERS][tail] -> QUEUE[head][(tail+1) % M][tot+1][serving]
	|when (tot > 0 && serving == EMPTY) serve[user:USERS][head] -> QUEUE[(head+1) % M][tail][tot-1][FULL]
	|when (serving == FULL) exit[user:USERS] -> QUEUE[head][tail][tot][EMPTY]).


||USERS = (USER(1) || USER(2) || USER(3)).
||SYSTEM = (LIFT || USERS || FLOOR).










