const N = 2
const M = 3
const EMPTY = 0
const FULL = 1
range FLOORS_RANGE = 0..N-1
range MODE = 0..1
range RANGE_QUEUE = 0..M-1

LOCK = (acquire -> release -> LOCK).

LIFT = EMPTY[0],
EMPTY[f:FLOORS_RANGE] =
	(floor_button_pressed[floor:FLOORS_RANGE] -> MOVING[f][floor][EMPTY]
	|alarm_triggered -> EMERGENCY[f][EMPTY]),
MOVING[start:FLOORS_RANGE][finish:FLOORS_RANGE][mode:MODE] =
	(when (start == finish) open_door -> ON_FLOOR[start]
	|when (start < finish) move_up -> MOVING[start+1][finish][mode]
	|when (start > finish) move_down -> MOVING[start-1][finish][mode]
	|alarm_triggered -> EMERGENCY[start][mode]),
ON_FLOOR[f:FLOORS_RANGE] = 
	(enter -> FULL[f]
	|exit -> close_door -> EMPTY[f]
	|alarm_triggered -> close_door_emergency -> EMERGENCY[f][EMPTY]),
FULL[f:FLOORS_RANGE] = 
	(lift_button_pressed[floor:FLOORS_RANGE] -> close_door -> MOVING[f][floor][FULL]
	|alarm_triggered -> close_door_emergency -> EMERGENCY[f][FULL]),
EMERGENCY[start:FLOORS_RANGE][mode:MODE] = 
	(when (start > 0) move_down -> EMERGENCY[start-1][mode]
	|when (start == 0 && mode == FULL) open_door_emergency -> signal -> close_door -> EMPTY[0]
	|when (start == 0 && mode == EMPTY) open_door -> signal -> close_door -> EMPTY[0]).



USER(U = 1, F = 0) = 
	(get_in_line[ticket:RANGE_QUEUE][F][U] -> IN_LINE[ticket]),
IN_LINE[ticket:RANGE_QUEUE] =
	(serve[ticket][F][U] -> CALLING),
CALLING = 
	(floor_button_pressed[F] -> WAITING
	|alarm_triggered -> USER),
WAITING = 
	(acquire -> enter -> ON_BOARD
	|alarm_triggered -> USER),
ON_BOARD = 
	(lift_button_pressed[dest:FLOORS_RANGE] -> MOVING_USER
	|alarm_triggered -> EXIT_EMERGENCY),
MOVING_USER = 
	(exit -> release -> USER
	|alarm_triggered -> EXIT_EMERGENCY),
EXIT_EMERGENCY = (open_door_emergency -> exit_emergency -> release -> USER).


FLOOR(F = 0) = QUEUE[0][0][0],
QUEUE[head:RANGE_QUEUE][tail:RANGE_QUEUE][tot:0..M] = 
	(when (tot < M) get_in_line[tail][F][user:1..3] -> QUEUE[head][(tail+1) % M][tot+1]
	|when (tot > 0) tocca_Al_Piano[F] -> serve[head][F][user:1..3] -> QUEUE[(head+1) % M][tail][tot-1]).

// Avevo pensato (ma poi non sono riuscita perchè sono partita) che si potrebbe fare (oltre alla lista piccola per ogni piano) una globale
// e fare la serve che si sincronizza con utente, floor e quella globale, usando le head di entrambe per far si che solo una serve possa 
// essere fatta alla volta ( serve[head_global][head_floor][Floor][User] ). Ovviamente anche la get_in_line dovrebbe avere il campo 
// aggiuntivo per la tail della lista globale. Questa avrebbe come range_queue 0..(N*M)-1 e la stessa strttura di FLOOR (togliendo 
// l'azione tocca_Al_Piano e spostando l'acquire prima della serve nell'utente).
// NON SO SE A SENSO, era un'idea che mi era venuta ma poi non ero riuscita a provarla e scriverla quindi se per voi non ha senso potete 
// ignorarla e provare a trovare un modo per gestire quando tocca ad un determinato piano :)


||USERS = (USER(1, 0) || USER(2, 1) || USER(3, 0)). //vanno rinominate delle azioni per la sincronizzazione!? -> bohhhh
||FLOORS = (FLOOR(0) || FLOOR(1) || FLOOR(2)).

||SYSTEM = (LOCK || LIFT || USERS || FLOORS).










